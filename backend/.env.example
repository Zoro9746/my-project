PORT=5000
NODE_ENV=development

# For local SQLite development:
DATABASE_URL="file:./dev.db"
# DIRECT_URL not needed for SQLite

# For Neon PostgreSQL production (set these in Render dashboard, never commit real values):
# DATABASE_URL="postgres://user:pass@host-pooler.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgres://user:pass@host.neon.tech/neondb?sslmode=require"

JWT_SECRET="your_jwt_secret_key"
JWT_EXPIRES_IN="24h"
